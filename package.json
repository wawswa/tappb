{
  "name": "spotbird",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter spotbird-api dev",
    "dev:web": "pnpm --filter spotbird-web dev",
    "build": "pnpm --filter spotbird-web build",
    "preview": "pnpm --filter spotbird-web preview",
    "typecheck": "pnpm --filter spotbird-web typecheck",
    "db:up": "bash scripts/db-up.sh",
    "db:reset": "bash scripts/db-reset.sh",
    "db:psql": "bash scripts/db-psql.sh"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide",
      "lightningcss",
      "sharp"
    ]
  }
}
